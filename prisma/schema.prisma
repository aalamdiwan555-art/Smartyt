generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  creatorName        String?  @map("creator_name")
  mainLanguage       String   @default("en") @map("main_language")
  targetAudience     String?  @map("target_audience")
  contentFormat      String?  @map("content_format") // 'long_form' | 'shorts' | 'both'
  mainTopics         String[] @map("main_topics")
  goals              String[]
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  avatarUrl          String?  @map("avatar_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  youtubeChannels    YouTubeChannel[]
  oauthConnections   OAuthConnection[]
  subscriptions      Subscription[]
  usage              Usage[]
  projects           Project[]
  ideas              Idea[]
  scripts            Script[]
  keywordSearches    KeywordSearch[]
  videoDrafts        VideoDraft[]
  uploads            Upload[]
  thumbnailProjects  ThumbnailProject[]
  contentCalendar    ContentCalendar[]
  notifications      Notification[]
  teamMembers        TeamMember[]
  supportTickets     SupportTicket[]
  auditLogs          AuditLog[]
  jobs               Job[]
  contentDNA         ContentDNA?

  @@map("profiles")
}

model ContentDNA {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  profile               Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  niche                 String?
  tone                  String?
  audience              String?
  typicalDurationSeconds Int?    @map("typical_duration_seconds")
  preferredFormats      String[] @map("preferred_formats")
  favoriteTopics        String[] @map("favorite_topics")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("content_dna")
}

model YouTubeChannel {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  profile         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeChannelId String  @unique @map("youtube_channel_id")
  channelTitle    String?  @map("channel_title")
  avatarUrl       String?  @map("avatar_url")
  subscriberCount BigInt?  @map("subscriber_count")
  isActive        Boolean  @default(true) @map("is_active")
  connectedAt     DateTime @default(now()) @map("connected_at")

  oauthConnections OAuthConnection[]
  videoDrafts      VideoDraft[]
  analyticsCache   AnalyticsCache[]
  projects         Project[]

  @@map("youtube_channels")
}

model OAuthConnection {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  profile              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId            String?  @map("channel_id")
  channel              YouTubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  provider             String   @default("google")
  accessTokenEncrypted String   @map("access_token_encrypted")
  refreshTokenEncrypted String  @map("refresh_token_encrypted")
  scope                String?
  expiresAt            DateTime? @map("expires_at")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("oauth_connections")
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")
  profile              Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String   @default("free") // 'free' | 'pro' | 'team'
  stripeCustomerId     String?  @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  status               String?  // 'active' | 'past_due' | 'canceled'
  currentPeriodEnd     DateTime? @map("current_period_end")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model Usage {
  id                       String   @id @default(uuid())
  userId                   String   @map("user_id")
  profile                  Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart              DateTime @map("period_start") @db.Date
  aiGenerationsUsed        Int      @default(0) @map("ai_generations_used")
  keywordSearchesUsed      Int      @default(0) @map("keyword_searches_used")
  thumbnailGenerationsUsed Int      @default(0) @map("thumbnail_generations_used")
  uploadsUsed              Int      @default(0) @map("uploads_used")

  @@unique([userId, periodStart])
  @@map("usage")
}

model Project {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId String?  @map("channel_id")
  channel   YouTubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  ideas       Idea[]
  videoDrafts VideoDraft[]

  @@map("projects")
}

model Idea {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String   @map("user_id")
  profile         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleConcept    String?  @map("title_concept")
  contentAngle    String?  @map("content_angle")
  hook            String?
  targetAudience  String?  @map("target_audience")
  suggestedKeywords String[] @map("suggested_keywords")
  thumbnailConcept String?  @map("thumbnail_concept")
  status          String   @default("idea") // 'idea'|'in_progress'|'archived'
  createdAt       DateTime @default(now()) @map("created_at")

  scripts Script[]

  @@map("ideas")
}

model Script {
  id        String   @id @default(uuid())
  ideaId    String   @map("idea_id")
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hook      String?
  body      String?
  cta       String?
  language  String   @default("en")
  tone      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scripts")
}

model KeywordSearch {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  source    String   // 'youtube_api' | 'ai_estimate' | 'smartyt_calc'
  results   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keyword_searches")
}

model VideoDraft {
  id               String   @id @default(uuid())
  projectId        String?  @map("project_id")
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId           String   @map("user_id")
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId        String?  @map("channel_id")
  channel          YouTubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  title            String?
  description      String?
  tags             String[]
  categoryId       String?  @map("category_id")
  language         String?
  visibility       String   @default("private") // 'private'|'unlisted'|'public'
  playlistId       String?  @map("playlist_id")
  scheduledAt      DateTime? @map("scheduled_at")
  thumbnailUrl     String?  @map("thumbnail_url")
  videoStoragePath String?  @map("video_storage_path")
  status           String   @default("draft") // 'idea'|'draft'|'editing'|'ready'|'scheduled'|'published'|'failed'
  checklist        Json?
  seoScore         Json?    @map("seo_score")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  uploads           Upload[]
  thumbnailProjects ThumbnailProject[]
  contentCalendar   ContentCalendar[]

  @@map("video_drafts")
}

model Upload {
  id             String   @id @default(uuid())
  draftId        String   @map("draft_id")
  draft          VideoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeVideoId String?  @map("youtube_video_id")
  uploadStatus   String   @default("pending") @map("upload_status") // 'pending'|'uploading'|'processing'|'succeeded'|'failed'
  progressPercent Int     @default(0) @map("progress_percent")
  errorMessage   String?  @map("error_message")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("uploads")
}

model ThumbnailProject {
  id               String   @id @default(uuid())
  draftId          String?  @map("draft_id")
  draft            VideoDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  userId           String   @map("user_id")
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasJson       Json?    @map("canvas_json")
  exportedImageUrl String?  @map("exported_image_url")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("thumbnail_projects")
}

model ContentCalendar {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  draftId       String?  @map("draft_id")
  draft         VideoDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  title         String
  scheduledDate DateTime @map("scheduled_date") @db.Date
  type          String   // 'video'|'short'|'idea'|'campaign'
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("content_calendar")
}

model AnalyticsCache {
  id                      String   @id @default(uuid())
  channelId               String   @map("channel_id")
  channel                 YouTubeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  youtubeVideoId          String   @map("youtube_video_id")
  metricDate              DateTime @map("metric_date") @db.Date
  views                   BigInt?
  watchTimeMinutes        BigInt?  @map("watch_time_minutes")
  likes                   BigInt?
  comments                BigInt?
  impressions             BigInt?
  ctr                     Decimal? @db.Decimal(5, 4)
  avgViewDurationSeconds  Int?     @map("avg_view_duration_seconds")
  fetchedAt               DateTime @default(now()) @map("fetched_at")

  @@unique([channelId, youtubeVideoId, metricDate])
  @@map("analytics_cache")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model Team {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  members TeamMember[]

  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String // 'owner'|'admin'|'editor'|'analyst'|'viewer'

  @@unique([teamId, userId])
  @@map("team_members")
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("support_tickets")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  profile   Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

model Job {
  id        String   @id @default(uuid())
  type      String   // 'publish_scheduled_video'|'refresh_analytics'|...
  payload   Json?
  runAt     DateTime @map("run_at")
  status    String   @default("pending") // 'pending'|'running'|'done'|'failed'
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  profile   Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("jobs")
}
